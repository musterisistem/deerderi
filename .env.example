# =============================================
# DEER DERI — Ortam Değişkenleri
# =============================================
# Bu dosyayı ".env" olarak kopyalayın ve gerçek değerleri girin.
# Örnek: copy .env.example .env

# --- MongoDB Atlas (zorunlu, e-ticaret işlemleri için) ---
MONGODB_URI=mongodb+srv://KULLANICI:SIFRE@cluster.mongodb.net/deerderi?retryWrites=true&w=majority

# --- Resend E-posta (isteğe bağlı) ---
RESEND_API_KEY=re_xxxxx
RESEND_FROM=siparis@deerderi.com

# --- Bunny CDN Storage (görsel yükleme için) ---
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_ZONE=deerderi
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_CDN_URL=https://deerderi.b-cdn.net

# --- Güvenlik ---
JWT_ADMIN_SECRET=super-gizli-admin-jwt-key-buraya
JWT_CUSTOMER_SECRET=super-gizli-musteri-jwt-key-buraya
